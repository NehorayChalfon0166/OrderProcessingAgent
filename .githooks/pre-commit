#!/bin/bash
# Pre-commit hook — mechanical checks enforced on every commit.
#
# Runs:
#   1. Branch rules (no master-file modifications on *-integration branches)
#   2. Full test suite (pytest discovers everything in tests/ automatically)
#   3. Standalone integration tests
#   4. Live smoke test (CLI entry point doesn't crash)
#
# Any failure blocks the commit.
# Manual review is enforced separately via Claude Code's PreToolUse hook
# (see settings.json and CLAUDE.md § Commit Workflow).

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m'

PASSED=true
branch=$(git branch --show-current)

# ═══════════════════════════════════════════════════════════════════
# 1. Branch rules — *-integration cannot modify master files
# ═══════════════════════════════════════════════════════════════════
if [ "$branch" != "master" ] && [[ "$branch" =~ -integration$ ]]; then
    master_files=$(git ls-tree -r master --name-only 2>/dev/null)
    if [ -n "$master_files" ]; then
        changed=$(git diff --cached --name-only)
        candidates=$(comm -12 <(echo "$master_files" | sort) <(echo "$changed" | sort))

        violations=""
        for f in $candidates; do
            if ! git diff --quiet --cached master -- "$f" 2>/dev/null; then
                violations="$violations $f"
            fi
        done
        violations=$(echo "$violations" | xargs)

        if [ -n "$violations" ]; then
            echo -e "${RED}╔══════════════════════════════════════════════════════════╗${NC}"
            echo -e "${RED}║  BRANCH VIOLATION — integration branch cannot modify    ║${NC}"
            echo -e "${RED}║  files that exist on master. Core improvements → master.║${NC}"
            echo -e "${RED}╚══════════════════════════════════════════════════════════╝${NC}"
            for f in $violations; do echo "    - $f"; done
            echo ""
            exit 1
        fi
    fi
fi

# ═══════════════════════════════════════════════════════════════════
# 2. Pytest suite — auto-discovers all tests in tests/
# ═══════════════════════════════════════════════════════════════════
echo -n "  pytest .................. "
if python -m pytest tests/ -q > /dev/null 2>&1; then
    echo -e "${GREEN}OK${NC}"
else
    echo -e "${RED}FAIL${NC}"
    echo "  Run: python -m pytest tests/ -v"
    PASSED=false
fi

# ═══════════════════════════════════════════════════════════════════
# 3. Standalone integration tests
# ═══════════════════════════════════════════════════════════════════
echo -n "  integration tests ....... "
if python tests/test_integration.py > /dev/null 2>&1; then
    echo -e "${GREEN}OK${NC}"
else
    echo -e "${RED}FAIL${NC}"
    echo "  Run: python tests/test_integration.py"
    PASSED=false
fi

# ═══════════════════════════════════════════════════════════════════
# 4. Live smoke test — CLI entry point
# ═══════════════════════════════════════════════════════════════════
echo -n "  live smoke test ......... "
result=$(python -c "
from unittest import mock; import sys, io
with mock.patch('main.process_turn', return_value='Welcome!'):
    from config import AppConfig; from main import run_session
    sys.stdin = io.StringIO('quit\n')
    run_session(AppConfig.from_env())
    print('OK')
" 2>&1)
if echo "$result" | grep -q "OK"; then
    echo -e "${GREEN}OK${NC}"
else
    echo -e "${RED}FAIL${NC}"
    echo "  Error: $(echo "$result" | head -3)"
    PASSED=false
fi

# ═══════════════════════════════════════════════════════════════════
if [ "$PASSED" = "false" ]; then
    echo ""
    echo -e "${RED}  Mechanical checks failed — commit blocked.${NC}"
    echo ""
    exit 1
fi

echo ""
echo -e "${GREEN}  All checks passed.${NC}"
echo ""
exit 0
