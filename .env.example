# =============================================================================
# Order Processing Agent — Environment Variables
# =============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# In production, set these via your deployment platform (Docker, systemd, etc.)
# Never commit .env to version control — it's in .gitignore.
#
# If your keys were ever exposed (logs, screenshots, zip files), rotate them:
#   DeepSeek: https://platform.deepseek.com/api_keys
#   Twilio:   https://console.twilio.com → Settings → API Keys
# =============================================================================

# Required — DeepSeek API key
DEEPSEEK_API_KEY=sk-your-key-here

# Optional overrides
# LLM_MODEL=deepseek-v4-flash
# LLM_BASE_URL=https://api.deepseek.com
# LLM_TEMPERATURE=0.3

# Agent tuning
# MAX_ITERATIONS=5
# AGENT_TIMEOUT_SECONDS=45
# RATE_LIMIT_MAX_PER_MINUTE=20
# SESSION_STALE_HOURS=2
# SESSION_CLEANUP_DAYS=30

# Twilio (required for WhatsApp server)
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_WHATSAPP_NUMBER=+1...

# Stripe (dormant — not available in Israel)
# STRIPE_SECRET_KEY=sk_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Dashboard + printer agent authentication
# API_TOKEN=generate-a-strong-random-token-here
