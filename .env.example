# =============================================================================
# Mario's Pizzeria — Order Processing Agent Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# -----------------------------------------------------------------------------
# LLM Provider
# -----------------------------------------------------------------------------
# Supported: groq | gemini | openrouter | mistral | ollama
LLM_PROVIDER=groq

# -----------------------------------------------------------------------------
# API Key
# -----------------------------------------------------------------------------
# Required for all providers except Ollama (which runs locally).
#
# Get a free key:
#   Groq:       https://console.groq.com
#   Gemini:     https://aistudio.google.com/apikey
#   OpenRouter: https://openrouter.ai/keys
#   Mistral:    https://console.mistral.ai/api-keys
LLM_API_KEY=your_api_key_here

# -----------------------------------------------------------------------------
# Optional: Model and Base URL Overrides
# -----------------------------------------------------------------------------
# Uncomment to override the provider's default model or endpoint.
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_BASE_URL=https://api.groq.com/openai/v1

# -----------------------------------------------------------------------------
# App Settings
# -----------------------------------------------------------------------------
# Path to menu JSON file (relative to project root)
# MENU_PATH=menu.json

# Directory where confirmed orders are saved
# ORDERS_DIR=orders

# Enable debug logging (true/false)
# DEBUG=false
